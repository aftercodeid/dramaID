---
interface Props {
  locale: "id" | "en";
  slug: string; // "" for home, "privacy", "terms", "dmca", "delete-account", "support"
}

const { locale, slug } = Astro.props;
const idPath = slug ? `/${slug}` : "/";
const enPath = slug ? `/en/${slug}` : "/en";
---

<nav class="lang-switch" aria-label="Language">
  <a href={idPath} aria-current={locale === "id" ? "page" : undefined}>ID</a>
  <a href={enPath} aria-current={locale === "en" ? "page" : undefined}>EN</a>
</nav>
